{
  "extends": "./tsconfig.json",
  "angularCompilerOptions": {
    "skipTemplateCodegen": true,
    "enableResourceInlining": true,
    "compilationMode": "partial"
  },
  "compilerOptions": {
    "outDir": "AUTOGENERATED",
    "declaration": true,
    "declarationDir": "AUTOGENERATED",
    "inlineSourceMap": true,
    "inlineSources": true
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "**/*.spec.ts"
  ]
}
